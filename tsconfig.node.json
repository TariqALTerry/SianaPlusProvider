{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node"],

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,

    // A project on the receiving end of `references` may not disable emit, so this one emits
    // declarations into a throwaway directory instead. Nothing consumes them; the point is the
    // type check, and `noEmit` here would fail the reference in tsconfig.json.
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/node-types",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["vite.config.ts", "vitest.config.ts", "tailwind.config.ts", "playwright.config.ts"]
}
