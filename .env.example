# Every client-visible variable MUST be prefixed with VITE_. This is the only env file tracked
# in Git; copy it to .env.development / .env.production and fill real values.

# Origin of the Siana API, WITHOUT the /api segment (endpoints are called as /api/...).
# Uploaded files come back as relative /uploads/... URLs and are prefixed with this too.
VITE_API_BASE_URL=http://localhost:5123

# Dev only: leave VITE_API_BASE_URL empty and set this to have the Vite dev server proxy
# /api and /uploads to an API whose CORS policy doesn't allow localhost (e.g. production).
# VITE_API_PROXY_TARGET=https://ebrahim1989-002-site11.ctempurl.com

VITE_APP_NAME=Siana Plus Provider

# ar (default, RTL) or en.
VITE_DEFAULT_LANG=ar

# Prefix for every localStorage key this app writes. Changing it signs everyone out.
VITE_STORAGE_PREFIX=siana.provider

# Optional: shown on the "organization suspended" screen and next to "contact support".
VITE_SUPPORT_PHONE=
# Optional: store links shown when a technician tries to sign in here.
VITE_EXECUTOR_APP_IOS_URL=
VITE_EXECUTOR_APP_ANDROID_URL=
